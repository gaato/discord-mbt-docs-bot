///|
/// Regenerates `src/docs/index_generated.mbt` from the discord.mbt guide:
///
///   moon run --target native --release src/gen [guide_dir [out_file]]
///
/// The defaults assume the ghq sibling checkout wired up in `moon.work`.
async fn main {
  let argv = @env.args()
  let guide_dir = argv.get(1).unwrap_or("../discord.mbt/src/guide")
  let out_file = argv.get(2).unwrap_or("src/docs/index_generated.mbt")
  let files = @fs.readdir(guide_dir).filter(is_chapter_file)
  // String's Compare is shortlex (length first), so sort lexicographically
  // to keep chapter files in `01-`, `02-`, ... order.
  files.sort_by(lex_compare)
  let sections = []
  for file in files {
    let content = @fs.read_file("\{guide_dir}/\{file}").text()
    sections.append(parse_chapter(file, content))
  }
  @fs.write_file(out_file, render(sections), create_mode=CreateOrTruncate)
  println("wrote \{sections.length()} sections to \{out_file}")
}

///|
fn lex_compare(a : String, b : String) -> Int {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    if a[i] != b[i] {
      return a[i].to_int() - b[i].to_int()
    }
  }
  a.length() - b.length()
}

///|
/// Chapter files are the numbered guides, e.g. `01-getting-started.mbt.md`.
fn is_chapter_file(name : String) -> Bool {
  name.has_suffix(".mbt.md") &&
  name.length() > 2 &&
  name[0] is ('0'..='9') &&
  name[1] is ('0'..='9')
}

///|
struct RawSection {
  chapter : String
  file : String
  title : String
  anchor : String
  body : Array[String]
}

///|
fn parse_chapter(file : String, content : String) -> Array[RawSection] {
  let sections : Array[RawSection] = []
  let mut chapter = file
  let mut current : RawSection? = None
  let flush = () => if current is Some(section) { sections.push(section) }
  for line in content.split("\n") {
    let line = line.to_owned()
    if line.has_prefix("# ") {
      chapter = line["# ".length():].to_owned()
      current = Some({ chapter, file, title: chapter, anchor: "", body: [] })
    } else if line.has_prefix("## ") {
      flush()
      let title = line["## ".length():].to_owned()
      current = Some({
        chapter,
        file,
        title,
        anchor: github_anchor(title),
        body: [],
      })
    } else if current is Some(section) {
      section.body.push(line)
    }
  }
  flush()
  sections
}

///|
/// GitHub heading anchors: lowercase, spaces to dashes, drop everything
/// that is not alphanumeric, dash, or underscore.
fn github_anchor(title : String) -> String {
  let out = StringBuilder()
  for c in title.to_lower() {
    match c {
      'a'..='z' | '0'..='9' | '-' | '_' => out <+ "\{c}"
      ' ' => out <+ "-"
      _ => ()
    }
  }
  out.to_string()
}

///|
fn render(sections : Array[RawSection]) -> String {
  let out = StringBuilder()
  out <+
    "// Generated by `moon run --target native --release src/gen`. Do not edit by hand.\n"
  out <+ "\n///|\npub let sections : Array[Section] = [\n"
  for section in sections {
    let body = trim_blank_lines(section.body)
    out <+ "  {\n"
    out <+ "    chapter: \{quote(section.chapter)},\n"
    out <+ "    file: \{quote(section.file)},\n"
    out <+ "    title: \{quote(section.title)},\n"
    out <+ "    anchor: \{quote(section.anchor)},\n"
    if body.is_empty() {
      out <+ "    body: \"\",\n"
    } else {
      out <+ "    body: (\n"
      for line in body {
        out <+ "      #|\{line}\n"
      }
      out <+ "    ),\n"
    }
    out <+ "  },\n"
  }
  out <+ "]\n"
  out.to_string()
}

///|
fn trim_blank_lines(lines : Array[String]) -> ArrayView[String] {
  let mut start = 0
  let mut stop = lines.length()
  while start < stop && lines[start].trim().is_empty() {
    start += 1
  }
  while stop > start && lines[stop - 1].trim().is_empty() {
    stop -= 1
  }
  lines[start:stop]
}

///|
/// Emit a MoonBit string literal. Escaping the backslash first also
/// neutralizes would-be `\{...}` interpolations.
fn quote(s : String) -> String {
  let out = StringBuilder()
  out <+ "\""
  for c in s {
    match c {
      '\\' => out <+ "\\\\"
      '"' => out <+ "\\\""
      '\n' => out <+ "\\n"
      _ => out <+ "\{c}"
    }
  }
  out <+ "\""
  out.to_string()
}
