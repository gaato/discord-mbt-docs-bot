import {
  "moonbitlang/core/encoding/utf8",
  "gaato/discord",
  "gaato/discord-mbt-docs-bot/app",
  "gaato/discord/model",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/json",
}

// This package is intentionally empty on non-JavaScript targets.

warnings = "-29"

supported_targets = "js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/js_async",
  ],
  link: {
    "js": {
      "exports": [ "start_interaction", "verify_signature" ],
      "format": "esm",
    },
  },
  targets: { "worker.mbt": [ "js" ] },
)
